# Copy to .env (`cp .env.example .env`). .env is gitignored: never commit it.
# The placeholder values work for local dev; replace them anywhere else.
# Generate secrets with: openssl rand -hex 32

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=hypertube
# Superuser, only used by the db container to initialise the cluster.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser-password
# Restricted role the backend connects with (created by scripts/init-db).
# Use URL-safe characters only: it is inserted into DATABASE_URL.
APP_DB_USER=hypertube_app
APP_DB_PASSWORD=change-me-app-db-password

# --- Backend ------------------------------------------------------------------
# Signs the short-lived OAuth state cookie. At least 32 characters.
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
# Where the browser reaches the frontend and the API.
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
API_HOST_PORT=8000
# Browsers accept Secure cookies on http://localhost, so keep this true.
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30

# --- Mail (Mailpit in dev: http://localhost:8025) -----------------------------
MAIL_FROM=Hypertube <no-reply@hypertube.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAILPIT_HOST_PORT=8025

# --- OAuth --------------------------------------------------------------------
# Leave empty to disable a provider. Redirect URIs to register:
#   42:     ${PUBLIC_API_URL}/api/auth/oauth/42/callback      (https://profile.intra.42.fr/oauth/applications)
#   Google: ${PUBLIC_API_URL}/api/auth/oauth/google/callback  (https://console.cloud.google.com/apis/credentials)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cleanup jobs -------------------------------------------------------------
# Movie files unwatched for this many days are deleted from the server.
MOVIE_RETENTION_DAYS=30
CLEANUP_INTERVAL_MINUTES=60
