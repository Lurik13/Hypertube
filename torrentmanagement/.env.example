# Copy these settings into your ignored .env file and replace both passwords.
TM_HOST_PORT=8000
# PostgreSQL database and restricted application role.
TM_DB_NAME=torrentmanagement
TM_DB_USER=torrentmanagement_app
TM_DB_PASSWORD=replace-with-a-long-random-application-password
# Initialization-only PostgreSQL administrator credentials.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-different-long-random-password
TM_DB_CONNECT_TIMEOUT=5
# Torrent metadata, request wait, and stream worker limits.
TM_MAX_TORRENT_BYTES=10485760
TM_MAX_TORRENT_CONTENT_BYTES=214748364800
TM_RANGE_CHUNK_BYTES=1048576
TM_RANGE_WAIT_SECONDS=120
TM_STREAM_WORKERS=2
# Optional SubDL API key; subtitles remain disabled until configured.
SUBDL_API_KEY=
